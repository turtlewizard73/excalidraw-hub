# Copy to .env. Compose reads it; bash does not export UID/GID by itself.
UID=1000
GID=1000
# HUB_PORT=3080
# HUB_REPO=./drawings     # folder holding the drawings; git sync is on if it is a git repo's top level
# HUB_DRAWINGS_SUBDIR=.   # drawings folder inside HUB_REPO, e.g. docs/drawings
# HUB_BACKUPS=./backups
# HUB_WORKSPACE=./workspace     # holds workspace.json: folders attached in the sidebar
# HUB_FOLDERS_ROOT=/home/me     # absolute path; attach only folders inside it (default: $HOME); Docker mounts it read-write
# SYNC_BRANCH=main        # the only branch sync pushes from
# CANVAS_URL=http://127.0.0.1:3000
# CANVAS_PUBLIC_URL=http://localhost:3000
# PLANTUML_URL=https://kroki.io/plantuml   # use this renderer, skip the plantuml container (diagram text leaves the machine)
