# Copy to .env. Compose and scripts/native.sh read it; bash does not export UID/GID by itself.
# Values shown are the defaults; the commented ones need no setting unless you change them.
UID=1000
GID=1000
# HUB_PORT=3080
# CANVAS_PORT=3000        # the agent's Excalidraw MCP and the hub iframe must use the same port
# FOLDERS_ROOT=/home/me   # absolute path; folders can be attached only inside it (default: $HOME). Docker mounts it read-write
# HUB_STATE=./config/hub.json   # attached and recent folders, written by the hub. Unset = this file in both runtimes; if set, use an absolute path (under Docker it must lie inside FOLDERS_ROOT)
# BACKUPS_DIR=./backups   # copies of overwritten drawings, for Revert
# HUB_AUTO_SYNC_BRANCHES=development,dev   # branches where the sync button commits and pushes without asking
# CANVAS_PUBLIC_URL=http://localhost:3000   # how the browser reaches the canvas; set it only behind a proxy or other host name
# PLANTUML_URL=https://kroki.io/plantuml   # use this renderer, skip the plantuml container (diagram text leaves the machine)
